# Application
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8080
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost
LOG_LEVEL=INFO

# MongoDB
MONGODB_URI=mongodb://mongo:27017
MONGODB_DB=dex_trading

# Auth — change these before any real deployment
JWT_SECRET=change-me-to-a-long-random-secret-key-32chars-min
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=ChangeMeNow!123

# OpenAI (optional — heuristic fallback used when unset)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Delta Exchange (https://docs.delta.exchange/#introduction) ──
# Public market data works without keys.
# Private orders need API key + secret (server-side only).
DEX_PROVIDER=delta
DEX_BASE_URL=https://api.india.delta.exchange
# Testnet: https://cdn-ind.testnet.deltaex.org
DELTA_API_KEY=
DELTA_API_SECRET=
# Keep false until you intentionally enable live order placement
DELTA_LIVE_TRADING=false

# Trading — start PAPER (live Delta prices, simulated fills)
TRADING_MODE=PAPER
TRADING_PAIRS=BTCUSD,ETHUSD
PAPER_STARTING_BALANCE=100000
MARKET_POLL_SECONDS=15
ENGINE_CYCLE_SECONDS=30
MARKET_STALE_SECONDS=90

# Risk defaults
MAX_POSITION_SIZE_USD=1000
MAX_DAILY_LOSS_USD=500
MAX_TRADES_PER_DAY=20
MAX_PORTFOLIO_EXPOSURE_PCT=50
STOP_LOSS_PCT=3
TAKE_PROFIT_PCT=6
MAX_SLIPPAGE_BPS=100
MIN_LIQUIDITY_USD=10000
MAX_GAS_USD=25
MIN_CONFIDENCE=60
MAX_OPEN_POSITIONS=5

# Frontend
VITE_API_URL=http://localhost:8080/api/v1

# WhatsApp alerts (optional — disabled by default)
WHATSAPP_ENABLED=false
WHATSAPP_TO=6206240867
WHATSAPP_PROVIDER=callmebot
CALLMEBOT_APIKEY=
# WHATSAPP_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# WHATSAPP_PROVIDER=meta
# WHATSAPP_META_TOKEN=
# WHATSAPP_META_PHONE_ID=
